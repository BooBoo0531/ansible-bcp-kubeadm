global
    log /dev/log local0
    log /dev/log local1 notice
    daemon
    maxconn 2048

defaults
    log global
    mode tcp
    option tcplog
    timeout connect 5s
    timeout client  50s
    timeout server  50s

frontend kubernetes-api
    bind *:{{ haproxy_port | default('8443') }}
    default_backend kubernetes-control-plane

backend kubernetes-control-plane
    option tcp-check
    {% for node in cluster_nodes %}
    server {{ node.name }} {{ node.ip }}:6443 check
    {% endfor %}
